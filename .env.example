# Frontend: valori pubblici (usare config.js o sostituzione in fase di deploy)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Supabase Edge Function secrets - non inserirli mai nel frontend
OPENAI_API_KEY=SET_IN_SUPABASE_SECRETS
OPENAI_MODEL=gpt-5-mini
EMAIL_SENDING_ENABLED=false
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=SET_LATER_IN_SUPABASE_SECRETS

# Futuro provider Aruba (NON configurare in questa fase)
ARUBA_IMAP_HOST=
ARUBA_IMAP_PORT=
ARUBA_IMAP_USERNAME=
ARUBA_IMAP_PASSWORD=
ARUBA_IMAP_TLS=true
ARUBA_SMTP_HOST=
ARUBA_SMTP_PORT=
ARUBA_SMTP_USERNAME=
ARUBA_SMTP_PASSWORD=
ARUBA_SMTP_TLS=true
ARUBA_FROM_ADDRESS=info@doublestruggleuniversity.com
